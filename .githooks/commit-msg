#!/usr/bin/env bash
# commit-msg — refuse OUTCOME CLAIMS in prose that no machine line supports.
#
# WHY: twice a commit message asserted a run outcome that was false. Once
# ("verify_bridge green") from misreading a piped $?; once ("red-pathed ... exits
# 1") with "exit=0 (expect 1)" printed on screen — the expectation overwrote the
# observation. checkrun fixed the INPUT to that step; this guards the step.
#
# RULE: if the message makes an explicit outcome claim, a CHECKRUN line must be
# present in the SAME message, and must not contradict it.
#   "exits 1" + "CHECKRUN ... EXIT=0"  -> REFUSED (contradiction)
#   "exits 1" + no CHECKRUN line       -> REFUSED (unsupported)
#   "exits 1" + "CHECKRUN ... EXIT=1"  -> allowed
# KNOWN LIMITATION, found when this hook refused the commit that introduced it:
# it cannot distinguish an ASSERTION from a QUOTATION. A message describing a past
# false claim ("the message claimed exit 1 while the terminal said 0") trips the
# contradiction check, because the literal pattern is present either way. That is
# the right failure direction -- the guard stays strict and the writer rephrases --
# but it means messages ABOUT outcome claims should paraphrase rather than quote.
# Bypass for a deliberate exception: git commit --no-verify
MSG_FILE="$1"
MSG=$(grep -v '^#' "$MSG_FILE")

CLAIM=$(printf '%s' "$MSG" | grep -oiE '\bexits? *=? *[0-9]+|\bgreen\b' | head -3)
[ -z "$CLAIM" ] && exit 0

CHECKRUN=$(printf '%s' "$MSG" | grep -oE 'CHECKRUN [^ ]+ EXIT=[0-9]+ (PASS|FAIL)' | head -5)
if [ -z "$CHECKRUN" ]; then
  echo "commit-msg REFUSED: the message makes an outcome claim --"
  printf '    %s\n' $CLAIM
  echo "  -- but contains no CHECKRUN line to support it."
  echo "  Run  ./checkrun.sh <checker>  and paste its machine-written line, or"
  echo "  drop the claim. (--no-verify to override deliberately.)"
  exit 1
fi

# contradiction check: a numeric claim that no CHECKRUN exit code matches
NUMS=$(printf '%s' "$MSG" | grep -oiE '\bexits? *=? *[0-9]+' | grep -oE '[0-9]+')
CODES=$(printf '%s' "$CHECKRUN" | grep -oE 'EXIT=[0-9]+' | grep -oE '[0-9]+')
for n in $NUMS; do
  ok=0
  for c in $CODES; do [ "$n" = "$c" ] && ok=1; done
  if [ "$ok" -eq 0 ]; then
    echo "commit-msg REFUSED: message claims exit $n, but the CHECKRUN line(s) say:"
    printf '    %s\n' "$CHECKRUN"
    echo "  The prose contradicts the machine record. This is the 2026-08-21 failure."
    exit 1
  fi
done
# PROVENANCE: every CHECKRUN line must have actually been PRODUCED by a run.
# Added 2026-09-09. checkrun.sh appends each line it writes to .checkrun_log with
# a timestamp; a line in a commit message that is not in that log within the
# window was TYPED rather than pasted -- which is how a false "EXIT=0 PASS" got
# into a message while the board was red. The hook already checked that a
# CHECKRUN line was PRESENT and self-consistent; it never checked that a run
# produced it.
LOG="$(git rev-parse --show-toplevel)/.checkrun_log"
WINDOW=${CHECKRUN_WINDOW_SECS:-10800}
NOW=$(date +%s)
FAILED=0
while IFS= read -r line; do
  [ -z "$line" ] && continue
  if [ ! -f "$LOG" ]; then
    echo "commit-msg REFUSED: message carries a CHECKRUN line but no .checkrun_log"
    echo "  exists, so nothing produced it. Run ./checkrun.sh and paste its output."
    FAILED=1; break
  fi
  HIT=$(grep -F -- "	$line" "$LOG" | tail -1 | cut -f1)
  # SUPERSESSION, added 2026-09-14. The check above finds the most recent line
  # MATCHING the pasted text and checks its age. It never asked whether a NEWER
  # run of the SAME CHECKER said something different -- so a genuine
  # "EXIT=0 PASS" from an hour ago stayed acceptable after the board had since
  # gone red. That is exactly the false-CHECKRUN failure the log was built to
  # make impossible, surviving in the gap between "was produced" and "is still
  # true". Found 2026-09-14 when a commit claiming 52/52 landed on a 51/52 tree.
  CHK=$(printf '%s' "$line" | awk '{print $2}')
  NEWEST=$(grep -E "	CHECKRUN $CHK EXIT=" "$LOG" | tail -1)
  NEWEST_TXT=$(printf '%s' "$NEWEST" | cut -f2)
  if [ -n "$NEWEST_TXT" ] && [ "$NEWEST_TXT" != "$line" ]; then
    echo "commit-msg REFUSED: this CHECKRUN line has been SUPERSEDED --"
    printf '    pasted: %s\n' "$line"
    printf '    newest: %s\n' "$NEWEST_TXT"
    echo "  A later run of the same checker disagrees. The pasted line was"
    echo "  produced, but it is no longer what the tree says. Re-run and paste"
    echo "  the current result, or fix what broke."
    FAILED=1; break
  fi
  if [ -z "$HIT" ]; then
    echo "commit-msg REFUSED: this CHECKRUN line was never produced by a run --"
    printf '    %s\n' "$line"
    echo "  It is not in .checkrun_log. A CHECKRUN line is a MACHINE record;"
    echo "  typing one by hand is the failure the log exists to make impossible."
    FAILED=1; break
  fi
  AGE=$(( NOW - HIT ))
  if [ "$AGE" -gt "$WINDOW" ]; then
    echo "commit-msg REFUSED: this CHECKRUN line is ${AGE}s old (window ${WINDOW}s) --"
    printf '    %s\n' "$line"
    echo "  A stale pass is not evidence about the tree you are committing."
    FAILED=1; break
  fi
done <<EOF
$CHECKRUN
EOF
[ "$FAILED" -eq 1 ] && exit 1
exit 0
